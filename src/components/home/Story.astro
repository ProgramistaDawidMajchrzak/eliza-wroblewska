---
import { getImage } from 'astro:assets';
import { photos } from '../../lib/data';
import { getPhoto } from '../../lib/photos';
import { useT, type Lang } from '../../i18n';
import Kicker from '../Kicker.astro';
import Photo from '../Photo.astro';
import Txt from '../Txt.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const video = photos.video;
const posterPhoto = getPhoto(video.poster);
const poster = await getImage({ src: posterPhoto.src, width: 480, format: 'webp' });
---

<section id={t.anchors.story} class="bg-white py-20 lg:py-28" aria-labelledby="story-title">
  <div class="wrap grid gap-12 lg:grid-cols-12 lg:items-start">
    <div class="lg:col-span-7">
      <Kicker num="02" text={t.story.kicker} />
      <h2 id="story-title" class="display mt-5 text-5xl sm:text-6xl xl:text-7xl">{t.story.title}</h2>
      <div class="prose-ew mt-7 max-w-[62ch] text-lg leading-relaxed">
        {t.story.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <figure class="mx-auto w-full max-w-[19rem] lg:col-span-4 lg:col-start-9 lg:mt-4">
      <div class="board p-2 pt-3">
        <video
          class="block aspect-[5/8] w-full bg-navy-800 object-cover"
          controls
          muted
          playsinline
          preload="none"
          poster={poster.src}
          width="480"
          height="768"
          aria-label={t.story.videoLabel}
        >
          <source src={video.file} type="video/mp4" />
        </video>
      </div>
      <figcaption class="mt-3 text-sm text-ink-soft">
        <span class="font-semibold text-ink">{video.caption[lang]}</span>
        {video.credit && (
          <span class="mt-1 block text-xs">
            {t.common.photoBy} <Txt text={video.credit} />
          </span>
        )}
      </figcaption>
    </figure>
  </div>

  <div class="wrap mt-16 grid gap-10 lg:mt-24 lg:grid-cols-12 lg:items-center lg:gap-12">
    <Photo
      lang={lang}
      id={photos.slots.values}
      ratio="4 / 5"
      sizes="(min-width: 1024px) 40vw, 100vw"
      widths={[480, 768, 1080, 1366]}
      class="lg:col-span-5"
    />
    <div class="lg:col-span-6 lg:col-start-7">
      <h3 class="display text-4xl sm:text-5xl" style="line-height: 1">{t.story.valuesTitle}</h3>
      <ol class="mt-8 space-y-6">
        {
          t.story.values.map((v, i) => (
            <li class="grid grid-cols-[3.75rem_1fr] gap-4 border-t-2 border-navy-900 pt-5">
              <span class="digits text-5xl text-flag" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h4 class="display text-2xl" style="font-stretch: 80%">{v.title}</h4>
                <p class="mt-1.5 leading-relaxed text-ink-soft">{v.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
