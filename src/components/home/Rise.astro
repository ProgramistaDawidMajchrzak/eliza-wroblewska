---
import { results, profile, photos } from '../../lib/data';
import { formatCompactDate } from '../../lib/format';
import { useT, routes, type Lang } from '../../i18n';
import Kicker from '../Kicker.astro';
import Photo from '../Photo.astro';
import ResultBadge from '../ResultBadge.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const items = results.filter((r) => r.rise).sort((a, b) => a.date.localeCompare(b.date));
const from = profile.previousCategory.replace(/\s*kg$/i, '');
const to = profile.category.replace(/\s*kg$/i, '');
---

<section id={t.anchors.rise} class="bg-gi py-20 lg:py-28" aria-labelledby="rise-title">
  <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5">
      <Kicker num="01" text={t.rise.kicker} />
      <h2 id="rise-title" class="display mt-5 text-5xl sm:text-6xl xl:text-7xl">{t.rise.title}</h2>
      <p class="mt-6 text-lg leading-relaxed">{t.rise.lead}</p>
      <p class="mt-4 leading-relaxed text-ink-soft">{t.rise.body}</p>
      <a href={routes.partnership[lang]} class="link-arrow mt-8 text-ink">
        {t.rise.cta} <span aria-hidden="true">→</span>
      </a>
      <Photo
        lang={lang}
        id={photos.slots.rise}
        ratio="3 / 2"
        sizes="(min-width: 1024px) 36vw, 100vw"
        widths={[480, 768, 985]}
        class="mt-12 hidden lg:block"
      />
    </div>

    <div class="lg:col-span-7">
      <div class="board px-5 pt-7 pb-6 sm:px-8 sm:pt-9 sm:pb-8">
        <p class="board-label text-white/75">{t.rise.switchLabel} · {profile.categorySince}</p>
        <p class="mt-4 flex items-end gap-3 sm:gap-6">
          <span class="digits text-6xl text-white/55 line-through decoration-flag-light decoration-[5px] sm:text-8xl">
            {from}
          </span>
          <svg viewBox="0 0 48 24" class="mb-3 h-6 w-10 shrink-0 text-flag-light sm:mb-6 sm:w-14" aria-hidden="true">
            <path d="M0 12h44M34 2l10 10-10 10" fill="none" stroke="currentColor" stroke-width="3"></path>
          </svg>
          <span class="digits text-7xl sm:text-9xl">
            {to}<span class="ml-1 text-3xl sm:text-5xl">kg</span>
          </span>
        </p>
      </div>

      <h3 class="board-label mt-10 text-ink-soft">{t.rise.listTitle}</h3>
      <ol class="mt-3 border-t-2 border-navy-900">
        {
          items.map((r) => (
            <li class="grid grid-cols-[6.25rem_1fr] items-baseline gap-x-4 border-b border-gi-300 py-4 sm:grid-cols-[8rem_9.5rem_1fr]">
              <span class="digits text-2xl text-ink-soft tabular-nums">{formatCompactDate(r.date, lang)}</span>
              <ResultBadge
                result={r.result}
                lang={lang}
                class="font-display text-sm font-bold tracking-wide uppercase sm:text-base"
              />
              <span class="col-start-2 mt-1 font-medium sm:col-start-auto sm:mt-0">{r.name[lang]}</span>
            </li>
          ))
        }
      </ol>

      <Photo
        lang={lang}
        id={photos.slots.rise}
        ratio="3 / 2"
        sizes="100vw"
        widths={[480, 768, 985]}
        class="mt-10 lg:hidden"
      />
    </div>
  </div>
</section>
